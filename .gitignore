# ───────── Dependencies (regenerate on the server with `npm install`) ─────────
node_modules

# ───────── Build output (regenerate with `npm run api:build` / `web:build`) ─────────
dist
build
*.tsbuildinfo

# ───────── Caches ─────────
.vite
coverage
.eslintcache
.cache

# ───────── Env / secrets (create fresh per environment from .env.example) ─────────
# `.env` at ANY depth is ignored (apps/api/.env, apps/web/.env) — but the
# `.env.example` templates are deliberately NOT ignored, so they stay in the repo.
.env
.env.local
.env.*.local
*.local

# ───────── Logs ─────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ───────── Uploaded files (user data — keep the folder, ignore its contents) ─────────
apps/api/uploads/*
!apps/api/uploads/.gitkeep

# ───────── Exported / imported spreadsheets (data, not source) ─────────
*.xlsx

# ───────── Editor / OS junk ─────────
.DS_Store
Thumbs.db
desktop.ini
.idea
*.suo
*.ntvs*
*.njsproj
*.sln

# Playwright MCP screenshots/snapshots (local QA artifacts)
.playwright-mcp/

# Claude Code local session config (per-machine, not shared)
.claude/

# ───────── Local server snapshots pulled for migration/debugging (contain real .env secrets) ─────────
fromServer/

# ───────── Local backup copies of env files (never commit real secrets) ─────────
*.env.bak
.env.*.bak
*.env.*.bak

# ───────── Database dumps (real company data — never commit) ─────────
*.sql
!deploy/migrations/*.sql
*:Zone.Identifier
