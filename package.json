{
  "name": "inframatrix",
  "version": "1.0.0",
  "private": true,
  "description": "InfraMatrix — unified platform for Infrastructure management and JobBag (vendor services, renewals, reminders), with shared users and per-module access.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm --workspace apps/api run start:dev",
    "api:build": "npm --workspace apps/api run build",
    "web:dev": "npm --workspace apps/web run dev",
    "web:build": "npm --workspace apps/web run build",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run api:dev\" \"npm run web:dev\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "shell-quote": "^1.8.4",
    "js-yaml": "^4.2.0",
    "multer": "^2.3.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.2.0"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
