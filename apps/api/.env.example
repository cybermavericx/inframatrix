# ── Runtime ───────────────────────────────────────────────
# Set to "production" on the server. In dev (anything else) the seed DROPS & rebuilds the schema.
NODE_ENV=development
# Single-port: NestJS serves the UI + API + uploads on this port. Must match the CloudPanel vhost.
PORT=3035
# Comma-separated allowed browser origins (CORS). Same-origin in the unified model; use the site URL in prod.
WEB_ORIGIN=http://127.0.0.1:3035
# Optional: override where the built UI is served from (default: ../web/dist relative to apps/api)
# WEB_DIST=

# ── Database (Laragon MySQL in dev) ───────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=infra-jobbag

# ── JWT (use long random strings in production) ───────────
JWT_ACCESS_SECRET=change_me_access
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=change_me_refresh
JWT_REFRESH_TTL=30d

# ── MFA (TOTP two-factor auth, self-service per user) ──────
# Secret for the short-lived (5 min) pending token issued between password and code steps.
JWT_MFA_SECRET=change_me_mfa
# 32-byte hex key for AES-256-GCM encryption of stored TOTP secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=
# Break-glass kill switch — leave unset/true (enforced). Set to "false" only to disable MFA for
# everyone at once if the feature itself is broken; see DEPLOY.md. Per-user "lost my phone" resets
# use `node dist/database/reset-mfa.js <email>` instead — this is the last resort.
MFA_ENFORCED=true

# ── Email (invites + reminder/expiry notifications) ───────
# Leave MAIL_HOST blank in dev — mail is logged to the console instead of sent.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@inframatrix.local
